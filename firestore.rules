rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── User workspace: owner-only access with document size limit ──
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.size() < 500000;  // 500KB max document
    }

    // ── Collaboration message queue ──
    match /users/{userId}/messages/{messageId} {
      allow read: if isOwner(userId);
      allow delete: if isAuthenticated()
        && (request.auth.uid == userId || resource.data.fromUid == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.keys().hasAll(['fromUid', 'type', 'payload', 'createdAt'])
        && request.resource.size() < 50000;  // 50KB max message
      allow update: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.size() < 50000;
    }

    // ── Push subscriptions (collaborators read to dispatch pushes) ──
    match /users/{userId}/push_subscriptions/{subId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── Email directory for user discovery ──
    match /directory_by_email/{emailHash} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
    }
  }
}
